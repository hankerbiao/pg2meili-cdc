# 复制为 .env.docker，并使用 docker compose --env-file .env.docker 启动。
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-database-password
PG_CONN_STRING=postgresql://postgres:replace-with-a-database-password@postgres:5432/postgres

OPEN_PLATFORM_ADMIN_USERNAME=admin
# docker compose run --rm unidata python scripts/hash_admin_password.py
# Argon2 摘要包含 $，粘贴后必须保留单引号，例如：'$argon2id$...'
OPEN_PLATFORM_ADMIN_PASSWORD_HASH=
OPEN_PLATFORM_SESSION_SECRET=replace-with-at-least-32-random-characters
OPEN_PLATFORM_SESSION_TTL_SECONDS=28800
OPEN_PLATFORM_COOKIE_SECURE=false

AGENT_REGISTRATION_TOKEN=replace-with-a-strong-agent-token
MEILI_MASTER_KEY=replace-with-a-strong-meilisearch-key

CORS_ALLOW_ORIGINS=http://localhost:8080
LOG_LEVEL=INFO
LOG_JSON=false
LOG_FILE_ENABLED=false

UNIDATA_PORT=8080
POSTGRES_PORT=5432
KAFKA_PORT=9092
# 远程 Go Agent 接入时改为 Docker 宿主机的可访问域名或 IP
KAFKA_EXTERNAL_HOST=localhost
REDIS_PORT=6379
MEILI_PORT=7700
CONNECT_PORT=8083
KAFKA_UI_PORT=8085

KAFKA_API_KEY_TOPIC=api_keys.events
KAFKA_COMMAND_TOPIC=meili.commands
KAFKA_DLQ_TOPIC=meili.dlq
