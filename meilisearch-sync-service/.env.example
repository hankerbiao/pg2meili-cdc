# Kafka Configuration
# Kafka broker 地址列表，多个地址用逗号分隔（必填）
KAFKA_BROKERS=localhost:9092
# 监听的 Kafka topic 列表，多个 topic 用逗号分隔
KAFKA_TOPIC=pg.public.search_outbox
# 部署区域。多区域部署时必填；留空时沿用旧 KAFKA_GROUP_ID 或消费者组前缀
REGION_ID=
# 消费者组前缀。最终 group 自动派生为 meilisearch-sync-service-<REGION_ID>
KAFKA_GROUP_PREFIX=meilisearch-sync-service

# Meilisearch Configuration
# Meilisearch 服务地址（必填，须含 http:// 或 https:// 前缀）
MEILI_HOST=http://localhost:7700
# Meilisearch API Key (如果有)
MEILI_API_KEY=
# CDC 批量写入。达到文档数或请求体大小时立即 flush；低流量窗口见服务日志。
MEILI_BATCH_ENABLED=true
MEILI_BATCH_SIZE=100
MEILI_BATCH_FLUSH_MS=100
MEILI_BATCH_MAX_BYTES=5242880
# 等待单个 Meilisearch 任务完成的上限（默认 5m）。注意耦合：必须始终小于
# 代码里的 Kafka SessionTimeout（当前 6m），否则长批次处理会被判定死亡触发 rebalance。
# TASK_TIMEOUT=5m
# 同一条消息连续以相同错误重试超过该次数后写入 DLQ，防止单分区头阻塞；
# 0 表示永不放弃。infra 级故障（如 Meilisearch 宕机）期间错误信息持续相同也可能触发，
# DLQ 保留完整消息可人工回放，需配合监控关注 DLQ 深度。
# KAFKA_HANDLE_MAX_ATTEMPTS=30
# Application Configuration
# 是否开启调试模式 (true/false)
DEBUG=false
# HTTP 服务监听地址
HTTP_ADDR=:8091
# UniData 中心地址，用于 Agent 注册与 API Key 快照预热
UNIDATA_URL=http://127.0.0.1:8080
# 外部服务访问当前 Agent 的稳定地址；未配置时回退为 http://AGENT_IP:AGENT_PORT
AGENT_PUBLIC_URL=https://search-tj.example.com
# Agent 向 UniData 注册时使用；须与 UniData 的同名配置一致
AGENT_REGISTRATION_TOKEN=replace-with-strong-random-token
# 开放平台应用/API Key 生命周期事件
KAFKA_API_KEY_TOPIC=api_keys.events

# 区域 API Key 注册表
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
