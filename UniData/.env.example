PG_CONN_STRING=postgres://postgres:change-me@127.0.0.1:5432/postgres
# 仅供 pytest 数据库用例使用；数据库名必须包含 test
TEST_PG_CONN_STRING=postgres://postgres:change-me@127.0.0.1:5432/unidata_test
SERVER_PORT=:8080
# 逗号分隔的允许来源；留空则不启用 CORS（仅同源访问）
CORS_ALLOW_ORIGINS=http://localhost:3100
LOG_FILE_ENABLED=true

# 容器内由镜像设置；本地留空时自动使用仓库目录
OPEN_PLATFORM_DIST_DIR=
PYTHON_SDK_ARCHIVE=

# 使用 scripts/hash_admin_password.py 生成
OPEN_PLATFORM_ADMIN_USERNAME=admin
OPEN_PLATFORM_ADMIN_PASSWORD_HASH=
OPEN_PLATFORM_SESSION_SECRET=replace-with-at-least-32-random-characters
OPEN_PLATFORM_SESSION_TTL_SECONDS=28800
# 仅在服务前置 HTTPS / TLS 终止时改为 true；HTTP（本地 / 容器 localhost）下必须为 false，否则管理员登录会话失效
OPEN_PLATFORM_COOKIE_SECURE=false
API_KEY_MAX_TTL_DAYS=365

KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_API_KEY_TOPIC=api_keys.events
AGENT_REGISTRATION_TOKEN=replace-with-strong-random-token

# Docker Secrets 可通过以下 *_FILE 变量覆盖对应值
# PG_CONN_STRING_FILE=/run/secrets/pg_conn_string
# OPEN_PLATFORM_ADMIN_PASSWORD_HASH_FILE=/run/secrets/open_platform_admin_password_hash
# OPEN_PLATFORM_SESSION_SECRET_FILE=/run/secrets/open_platform_session_secret
# AGENT_REGISTRATION_TOKEN_FILE=/run/secrets/agent_registration_token
